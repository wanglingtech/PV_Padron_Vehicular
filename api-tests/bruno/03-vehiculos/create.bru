meta {
  name: Crear vehículo
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/vehicles
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  x-user-role: admin
  x-user-email: {{adminEmail}}
  x-user-name: {{adminName}}
}

body:json {
  {
    "padronNumber": "TEST-001",
    "plate": "TST-001",
    "brand": "Toyota",
    "modelYear": 2022,
    "engineNumber": "ENG-TEST-001",
    "status": "ACTIVO",
    "owners": [
      {
        "fullName": "Propietario de Prueba",
        "dni": "99999999",
        "phone": "999888777",
        "isPrimary": true
      }
    ],
    "insurance": {
      "entityName": "AFOCAT Prueba",
      "policyNumber": "POL-001",
      "issueDate": "2026-01-01",
      "expirationDate": "2027-01-01"
    }
  }
}

tests {
  test("crea o detecta duplicado", function() {
    expect([201, 400, 409]).to.include(res.status);
  });
}
