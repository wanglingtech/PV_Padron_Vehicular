meta {
  name: Listar vehículos
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/vehicles?page=1&limit=10&sortBy=padronNumber&sortOrder=asc
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("devuelve arreglo de vehículos", function() {
    expect(res.body.vehicles).to.be.an("array");
  });
}
