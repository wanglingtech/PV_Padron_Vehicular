# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# PostgreSQL connection used by the API (server runtime)
# ---------------------------------------------------------------------------
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="YOUR_POSTGRES_PASSWORD"
SQL_DB_NAME="padron_vehicular"

# Set to "true" only when connecting to a remote/managed PostgreSQL that
# requires SSL (Neon, Supabase, Cloud SQL, etc.). Keep "false" for localhost.
SQL_SSL="false"

# AUTH_DEV_MODE: enables development tokens (dev-admin-token / dev-operator-token).
# Keep "true" only for local development. MUST be "false" in production.
AUTH_DEV_MODE="true"

# ---------------------------------------------------------------------------
# Datos de demostración (Fase 1 - hardening)
# ---------------------------------------------------------------------------
# Siembra las cuentas demo y el contenido de ejemplo (cartelera y agenda).
# En desarrollo se activa solo; en producción DEBE ser "false" para que no
# existan cuentas con contraseñas públicas.
SEED_DEMO_DATA="true"

# Permite que el servidor arranque en producción aunque existan cuentas demo
# activas. Úsalo solo en entornos de demostración expuestos a internet.
ALLOW_DEMO_ACCOUNTS="false"

# ---------------------------------------------------------------------------
# Autenticación real (Fase 1)
# ---------------------------------------------------------------------------
# Secreto para firmar las sesiones JWT. Obligatorio en producción (>= 32 chars).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-with-a-random-secret-of-at-least-32-characters"
# Duración de la sesión: 8h, 30m, 7d, etc.
JWT_EXPIRES_IN="8h"
# Nombre de la cookie HttpOnly de sesión.
AUTH_COOKIE_NAME="padron_session"
# "true" para forzar cookies Secure (HTTPS). En producción se activa solo.
AUTH_COOKIE_SECURE="false"
# SameSite: "lax" para mismo origen; "none" (con Secure) para dominios distintos.
AUTH_COOKIE_SAME_SITE="lax"
# Orígenes permitidos para CORS separados por coma. Vacío = solo mismo origen.
CORS_ORIGIN=""

# ---------------------------------------------------------------------------
# Recuperación de contraseña por correo (Fase 1)
# ---------------------------------------------------------------------------
# Si SMTP_HOST queda vacío, el servicio entra en MODO SIMULACIÓN: no envía
# correos, pero imprime el enlace de restablecimiento en la consola del
# servidor. Útil en desarrollo; en producción debe configurarse un SMTP real.
#
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# "true" para TLS implícito (puerto 465). Con 587 se usa STARTTLS.
# SMTP_SECURE="false"
# Credenciales del servidor de correo (si el servidor exige autenticación).
# SMTP_USER="tu-correo@transporte.pe"
# SMTP_PASSWORD="TU_CLAVE_DE_APLICACION"
# Remitente de los correos automáticos.
# SMTP_FROM="no-reply@transporte.pe"
# SMTP_FROM_NAME="Sistema de Padrón Vehicular"
# URL pública del frontend: se usa para componer el enlace del correo.
# APP_PUBLIC_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# PostgreSQL admin credentials used by drizzle-kit (schema push/studio only).
# For a local install these are usually the same as SQL_USER / SQL_PASSWORD.
# ---------------------------------------------------------------------------
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="YOUR_POSTGRES_PASSWORD"
