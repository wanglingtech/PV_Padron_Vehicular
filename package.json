{
  "name": "padron-vehicular",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('fs').rmSync('server.js', { force: true });\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "db:push": "drizzle-kit push --config=backend/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=backend/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=backend/db/drizzle.config.ts",
    "db:reset-demo-passwords": "tsx scripts/reset-demo-passwords.ts",
    "db:remove-demo-users": "tsx scripts/remove-demo-users.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.2.1",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "sweetalert2": "^11.26.25",
    "vite": "^8.3.6",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
